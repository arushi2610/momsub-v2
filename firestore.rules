rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }
    
    function isValidId(id) { return id is string; } // Relaxed for dev
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
             data.email is string &&
             data.name is string &&
             (data.role == 'ADMIN' || data.role == 'PARENT' || data.role == 'NANNY');
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['parentId', 'nannyId', 'adminId', 'status', 'createdAt']);
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['matchId', 'type', 'status', 'totalHours', 'version', 'updatedAt', 'updatedBy']);
    }

    function isValidShift(data) {
      return data.keys().hasAll(['scheduleId', 'dayOfWeek', 'startTime', 'endTime', 'totalHours']) &&
             data.keys().size() == 5 &&
             isValidId(data.scheduleId) &&
             (data.dayOfWeek == 'MONDAY' || data.dayOfWeek == 'TUESDAY' || data.dayOfWeek == 'WEDNESDAY' || data.dayOfWeek == 'THURSDAY' || data.dayOfWeek == 'FRIDAY' || data.dayOfWeek == 'SATURDAY' || data.dayOfWeek == 'SUNDAY') &&
             data.startTime is string && data.endTime is string &&
             data.totalHours is number;
    }

    function isValidApproval(data) {
      return data.keys().hasAll(['scheduleId', 'userId', 'role', 'status', 'timestamp']);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'message', 'read', 'createdAt']);
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES
    // -------------------------------------------------------------------------

    // -------------------------------------------------------------------------
    // ADMIN ACCESS CODE
    //
    // The real code lives in config/admin. No client may read or write anything
    // here — but security rules CAN read it internally, and that asymmetry is what
    // makes the check impossible to bypass or to lift out of the page source.
    // -------------------------------------------------------------------------
    match /config/{docId} {
      allow read, write: if false;
    }

    // Proof that a user typed the correct admin access code. The write below only
    // succeeds when the submitted code matches config/admin, so a successful write
    // IS the verification. Reads are denied, so the stored code can never leak.
    match /admin_verifications/{userId} {
      allow read: if false;
      allow write: if isSignedIn() &&
                   userId == request.auth.uid &&
                   request.resource.data.code ==
                     get(/databases/$(database)/documents/config/admin).data.code;
    }

    match /users/{userId} {
      // The signed-in user's own email, normalized. Used to let someone claim the
      // record an admin pre-created for them.
      function myEmail() { return request.auth.token.email.lower(); }

      // Did this person prove they know the admin access code?
      function verifiedAdminCode() {
        return exists(/databases/$(database)/documents/admin_verifications/$(request.auth.uid));
      }

      // True when an admin has already created a record keyed by this person's email
      // and marked it ADMIN — the other way in, for people an admin adds directly
      // from the dashboard.
      function adminPreAuthorized() {
        return exists(/databases/$(database)/documents/users/$(myEmail())) &&
               get(/databases/$(database)/documents/users/$(myEmail())).data.role == 'ADMIN';
      }

      allow get: if isSignedIn();

      // Admins list everyone. Anyone else may only run a query that returns their
      // own record — needed at sign-up to find the record an admin pre-created.
      // Firestore enforces this per returned document, so a broader query fails.
      allow list: if isAdmin() || (isSignedIn() && resource.data.email == myEmail());

      // Anyone signed in may create their OWN record as PARENT or NANNY.
      // Becoming an ADMIN additionally requires either proving the admin access
      // code, or having been added as an admin from the dashboard. The browser
      // cannot fake either one.
      allow create: if isValidUser(incoming()) && (
                      isAdmin() ||
                      (isSignedIn() && userId == request.auth.uid &&
                        (incoming().role != 'ADMIN' ||
                         verifiedAdminCode() ||
                         adminPreAuthorized()))
                    );

      // Admins may change anyone's role (that is how someone is promoted to ADMIN).
      // A user editing their own profile may never change their own role.
      allow update: if (isAdmin() || (isSignedIn() && userId == request.auth.uid)) &&
                     isValidUser(incoming()) &&
                     (isAdmin() || incoming().role == existing().role);

      // After a pre-created record is claimed, the placeholder (random-ID) copy is
      // removed. Only an admin, or the person whose email it is, may do that.
      allow delete: if isAdmin() || (isSignedIn() && existing().email == myEmail());
    }

    match /parent_profiles/{profileId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /nanny_profiles/{profileId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /matches/{matchId} {
      allow get: if isAdmin() || (isSignedIn() && (existing().parentId == request.auth.uid || existing().nannyId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.parentId == request.auth.uid || resource.data.nannyId == request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && isValidMatch(incoming());

      match /messages/{messageId} {
        allow read, write: if isAdmin() || (isSignedIn() && (get(/databases/$(database)/documents/matches/$(matchId)).data.parentId == request.auth.uid || get(/databases/$(database)/documents/matches/$(matchId)).data.nannyId == request.auth.uid));
      }
    }

    match /schedules/{scheduleId} {
      function canAccessSchedule(matchId) {
        let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
        return isAdmin() || (isSignedIn() && (matchData.parentId == request.auth.uid || matchData.nannyId == request.auth.uid));
      }

      // The STANDARD (recurring) schedule is the admin's. Parents and nannies adjust
      // individual weeks; they must never be able to rewrite the pair's baseline.
      function isStandard() { return existing().type == 'STANDARD'; }

      allow get: if canAccessSchedule(existing().matchId);
      allow list: if isAdmin() || (isSignedIn() && canAccessSchedule(resource.data.matchId));

      allow create: if isValidSchedule(incoming()) &&
                    canAccessSchedule(incoming().matchId) &&
                    (isAdmin() || incoming().type == 'WEEKLY');

      allow update: if isValidSchedule(incoming()) &&
                    canAccessSchedule(existing().matchId) &&
                    // A schedule never moves to a different match.
                    incoming().matchId == existing().matchId &&
                    // Parents and nannies may only ever touch a single week, and may not
                    // reclassify it. Admins may (needed to migrate legacy records).
                    (isAdmin() || (!isStandard() && incoming().type == existing().type));

      allow delete: if isAdmin();

      match /shifts/{shiftId} {
        function parentSchedule() { return get(/databases/$(database)/documents/schedules/$(scheduleId)).data; }
        // A week's first adjustment creates the schedule and its shifts in ONE batch, so
        // at write time the parent schedule is not committed yet and get() would see
        // nothing. getAfter() evaluates against the post-commit state, which is what we
        // actually want to authorize against.
        function parentScheduleAfter() { return getAfter(/databases/$(database)/documents/schedules/$(scheduleId)).data; }

        allow read: if canAccessSchedule(parentSchedule().matchId);
        // Shifts on the recurring schedule are admin-only, same as the schedule itself.
        allow write: if canAccessSchedule(parentScheduleAfter().matchId) &&
                     (isAdmin() || parentScheduleAfter().type == 'WEEKLY');
      }

      match /approvals/{approvalId} {
        allow read: if canAccessSchedule(get(/databases/$(database)/documents/schedules/$(scheduleId)).data.matchId);
        // getAfter for the same reason as shifts: the approval that records a week's first
        // adjustment is batched with the creation of the schedule it belongs to.
        allow create: if isSignedIn() && isValidId(scheduleId) &&
                      canAccessSchedule(getAfter(/databases/$(database)/documents/schedules/$(scheduleId)).data.matchId) &&
                      isValidApproval(incoming());
      }

      match /messages/{messageId} {
        allow read, write: if canAccessSchedule(get(/databases/$(database)/documents/schedules/$(scheduleId)).data.matchId);
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isAdmin() || (isSignedIn()); // Allow users to send system-like notifications if needed for MVP
      allow update: if isSignedIn() && existing().userId == request.auth.uid && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }
  }
}
